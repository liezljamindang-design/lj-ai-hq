# ---- Browser-safe (VITE_ values are published with the site) ----
VITE_PORTFOLIO_URL=https://portfolio.liezljamindang.site

# ---- Server only: set these in Vercel > Settings > Environment Variables. Never commit real values. ----

# "Work with Liezl" form. Set ONE of the two delivery options.
# Option A (recommended): a GoHighLevel inbound webhook URL. Its workflow creates the contact and notifies Liezl.
LEAD_WEBHOOK_URL=
# Option B: send the email directly with Resend (https://resend.com).
RESEND_API_KEY=
LEAD_TO_EMAIL=liezljamindang@gmail.com

# Live AI chat. Without this key the employees answer from the written knowledge base.
ANTHROPIC_API_KEY=
